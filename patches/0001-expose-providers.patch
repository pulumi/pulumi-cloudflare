From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ian Wahbe <ian@wahbe.com>
Date: Thu, 11 May 2023 18:11:47 -0700
Subject: [PATCH] expose providers


diff --git a/shim/shim.go b/shim/shim.go
new file mode 100644
index 000000000000..2135a1a837a5
--- /dev/null
+++ b/shim/shim.go
@@ -0,0 +1,17 @@
+package shim
+
+import (
+	"github.com/hashicorp/terraform-plugin-framework/provider"
+
+	"github.com/cloudflare/terraform-provider-cloudflare/internal"
+)
+
+// UpstreamVersion is the terraform-provider-cloudflare release this shim is built from.
+// Upstream sends it in the User-Agent and x-stainless-package-version headers, so it must
+// name a real upstream release. TestShimUpstreamVersionMatchesSubmodule in the Pulumi
+// provider fails when it drifts from the checked-out submodule.
+const UpstreamVersion = "5.29.0"
+
+func PFProvider() provider.Provider {
+	return internal.NewProvider(UpstreamVersion)()
+}
